{
  "manifest_version": 3,
  "name": "Cookie Editor Pro",
  "version": "1.5.2",
  "description": "A beautiful cookie editor with profile management",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://server-sourse-1.onrender.com/*",
    "<all_urls>"
  ],
  "optional_permissions": [],
  "optional_host_permissions": [],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
